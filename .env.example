# RailClub Connect Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Default is SQLite for local dev; PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# Security & Field Encryption (Fernet / AES-256 + HMAC Blind Index)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-fernet-key-32-urlsafe-base64-bytes=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BLIND_INDEX_SALT=replace-with-64-char-hex-salt

# Timezone & Localization
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-in

# WhatsApp Cloud API (Institute Number: 7039145304)
# WHATSAPP_PROVIDER options: mock | cloudapi
WHATSAPP_PROVIDER=mock
WHATSAPP_SENDER_NUMBER=7039145304
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Redis / Celery (Optional for local dev, used for scheduler & background jobs)
REDIS_URL=redis://localhost:6379/0
